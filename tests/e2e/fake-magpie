#!/usr/bin/env bash
# fake magpie CLI wrapper for POSIX: lets MAGPIE_BIN point at an executable file.
# Runs fake-magpie.mjs with node when available, otherwise bun.
# Keep this file ASCII-only and LF-terminated: it is executed directly (mode 100755)
# by bash *and* by pwsh 7 on Linux/macOS in the e2e suite.
set -u
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${FAKE_MAGPIE_NODE:-}" ]; then
  exec "$FAKE_MAGPIE_NODE" "$dir/fake-magpie.mjs" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node "$dir/fake-magpie.mjs" "$@"
else
  exec bun "$dir/fake-magpie.mjs" "$@"
fi
